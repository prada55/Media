        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" TEXT NOT NULL, \"phone_hash\" TEXT NOT NULL, \"pin_hash\" TEXT NOT NULL, \"pin_salt\" TEXT NOT NULL, \"biometric_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"biometric_enabled\" IN (0, 1)), \"language\" TEXT NOT NULL DEFAULT 'fr', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"amount\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"transcript_fr\" TEXT NOT NULL, \"transcript_local\" TEXT NULL, \"audio_path\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
